{
  "name": "obsidian-dita-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "DITA reading view for Obsidian, built on a host-neutral DITA rendering core shared with the VS Code DITA Viewer.",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w obsidian-dita",
    "sync:test": "node scripts/sync-test-vault.mjs",
    "sync:root": "node scripts/sync-root-files.mjs",
    "sync:root:check": "node scripts/sync-root-files.mjs --check",
    "typecheck": "npm run typecheck -w obsidian-dita",
    "test": "npm test -w obsidian-dita && node --test scripts/release.test.mjs",
    "release:check": "node scripts/check-release.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run release:check"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.17.0",
    "@types/sax": "^1.2.7",
    "esbuild": "^0.28.2",
    "mocha": "^11.8.0",
    "obsidian": "^1.14.4",
    "typescript": "^5.7.0"
  }
}
